{
  "openapi": "3.0.1",
  "info": {
    "title": "YOLO Schedule API",
    "description": "API documentation for the YOLO Schedule Module",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080"
    }
  ],
  "tags": [
    {
      "name": "Schedule",
      "description": "Schedule Activity Types and Records Management"
    }
  ],
  "paths": {
    "/api/schedule/getActivityTypes": {
      "post": {
        "tags": [
          "Schedule"
        ],
        "summary": "Get schedule activity types",
        "parameters": [
          {
            "name": "typeName",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter by type name (fuzzy search)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ScheduleActivityType"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/schedule/createActivityType": {
      "post": {
        "tags": [
          "Schedule"
        ],
        "summary": "Create a new schedule activity type",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScheduleActivityType"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleActivityType"
                }
              }
            }
          }
        }
      }
    },
    "/api/schedule/updateActivityType": {
      "post": {
        "tags": [
          "Schedule"
        ],
        "summary": "Update an existing schedule activity type",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScheduleActivityType"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleActivityType"
                }
              }
            }
          }
        }
      }
    },
    "/api/schedule/deleteActivityType": {
      "post": {
        "tags": [
          "Schedule"
        ],
        "summary": "Delete a schedule activity type",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    },
    "/api/schedule/getRecords": {
      "post": {
        "tags": [
          "Schedule"
        ],
        "summary": "Get schedule records",
        "parameters": [
          {
            "name": "bizDate",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            },
            "description": "Filter by business date (YYYY-MM-DD)"
          },
          {
            "name": "recordType",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Filter by record type (e.g., plan, actual)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ScheduleRecord"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/schedule/deleteRecord": {
      "post": {
        "tags": [
          "Schedule"
        ],
        "summary": "Delete a schedule record",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    },
    "/api/schedule/batchSaveRecords": {
      "post": {
        "tags": [
          "Schedule"
        ],
        "summary": "Batch save (insert or update) schedule records",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/ScheduleRecord"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ScheduleActivityType": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "typeCode": {
            "type": "string"
          },
          "typeName": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "sort": {
            "type": "integer",
            "format": "int32"
          },
          "enableFlag": {
            "type": "integer",
            "format": "int32"
          },
          "createTime": {
            "type": "string",
            "format": "date-time"
          },
          "updateTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ScheduleRecord": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "bizDate": {
            "type": "string",
            "format": "date"
          },
          "timeSlot": {
            "type": "integer",
            "format": "int32"
          },
          "recordType": {
            "type": "string"
          },
          "activityType": {
            "type": "string"
          },
          "createTime": {
            "type": "string",
            "format": "date-time"
          },
          "updateTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}